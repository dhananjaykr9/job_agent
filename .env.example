# ──────────────────────────────────────────────
# AI Job Discovery Agent — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys

# Google Gemini API Key (required — free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Path to your existing Excel tracker
EXCEL_FILE_PATH=./jobs_tracker.xlsx

# SQLite database path
DATABASE_URL=sqlite:///./job_agent.db

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Logging level
LOG_LEVEL=INFO

# How often to run discovery automatically (in hours)
SCHEDULE_INTERVAL_HOURS=1

# Live Google Sheet URL
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1Naq2pmSfyt8ulXpq-7SKFmXfaerYnvkbjSy83SXRmT0/edit?usp=sharing

# Google Apps Script Webhook URL (for direct live sheet editing)
GOOGLE_SHEET_WEBHOOK_URL=
